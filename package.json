{
  "name": "textlens",
  "private": true,
  "version": "2.0.12",
  "description": "Privacy-first desktop text analysis with Rust and Tauri.",
  "author": {
    "name": "Sanskar",
    "email": "sanskarin@outlook.in",
    "url": "https://github.com/sanskarIN"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanskarIN/textlens.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "lint": "eslint src vite.config.ts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "release:tag-check": "node scripts/check-release-tag.mjs",
    "release:checksums": "node scripts/write-release-checksums.mjs",
    "release:checksums:verify": "node scripts/verify-release-checksums.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:smoke": "tauri build --debug --no-bundle",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.0.0",
    "@tauri-apps/plugin-dialog": "2.0.0",
    "@tauri-apps/plugin-opener": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.0.0",
    "@tauri-apps/cli": "2.0.0",
    "@types/node": "22.12.0",
    "eslint": "9.0.0",
    "prettier": "3.0.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.0",
    "vite": "7.0.0",
    "vitest": "3.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
