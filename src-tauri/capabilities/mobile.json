{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Minimal Android and iOS permissions for TextLens user-selected document workflows.",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "fs:allow-stat",
    "fs:allow-read-file",
    "fs:allow-write-text-file"
  ]
}
